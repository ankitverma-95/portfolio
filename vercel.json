{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/download-cv", "destination": "/AnkitVerma_Resume_Java.pdf" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/AnkitVerma_Resume_Java.pdf",
      "headers": [
        { "key": "Content-Disposition", "value": "attachment; filename=\"AnkitVerma_Resume.pdf\"" }
      ]
    }
  ]
}
